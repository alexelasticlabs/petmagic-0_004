# Admin Web environment
# Use the environment-specific examples for deployment:
# - .env.development.example
# - .env.staging.example
# - .env.production.example
# Copy the matching file to the environment provider. Do not commit real secrets.

# Public browser-facing API base URL. This is bundled into the client.
NEXT_PUBLIC_API_BASE_URL=https://api.petmagic.app

# Server-only API base URL for SSR/server actions if it differs from the public URL.
# Do not prefix private server-only variables with NEXT_PUBLIC_.
INTERNAL_API_BASE_URL=https://api.petmagic.app

# Comma-separated exact HTTPS origins used for signed/public media fetches.
ADMIN_MEDIA_ORIGINS=https://cdn.petmagic.app
PETMAGIC_APP_DEEP_LINK_SCHEME=petmagic
