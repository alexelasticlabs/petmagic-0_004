# Standalone Admin Web production reference values.
# Render deployment is declared in root render.production.yaml; do not upload
# this file as a secret source. Use it only for an independent admin-web build/provider.

# Public browser-facing API base URL. This is bundled into the client.
NEXT_PUBLIC_API_BASE_URL=https://api.petgpt.app

# Server-only API base URL for SSR/server actions if it differs from the public URL.
# Do not prefix private server-only variables with NEXT_PUBLIC_.
INTERNAL_API_BASE_URL=https://api.petgpt.app

# Set to the exact production R2/custom CDN origin; do not use wildcards.
# Keep this empty until the real R2 public/custom origin is configured.
ADMIN_MEDIA_ORIGINS=
PETMAGIC_APP_DEEP_LINK_SCHEME=petmagic
