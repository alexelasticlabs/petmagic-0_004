# Admin Web staging environment
# Copy to the staging environment provider. Do not commit real secrets.

# Public browser-facing API base URL. This is bundled into the client.
NEXT_PUBLIC_API_BASE_URL=https://api-staging.example.com

# Server-only API base URL for SSR/server actions if it differs from the public URL.
# Do not prefix private server-only variables with NEXT_PUBLIC_.
INTERNAL_API_BASE_URL=https://api-staging.example.com
