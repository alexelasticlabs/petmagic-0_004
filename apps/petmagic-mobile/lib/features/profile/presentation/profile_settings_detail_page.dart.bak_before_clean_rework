                    _LinkedAccountRow(
                      providerLabel: ExternalAuthProvider.apple.apiValue,
                      icon: Icons.apple_rounded,
                      account: _findLinkedAccount(
                        linkedAccounts,
                        ExternalAuthProvider.apple,
