String _buildLegalDocumentPlainText({
  required MobileLegalDocument document,
  required Locale locale,
}) {
  final isRu = locale.languageCode.toLowerCase() == 'ru';
  final versionLabel = isRu ? 'Версия' : 'Version';
  final publishedLabel = isRu ? 'Опубликовано' : 'Published';
  final publishedValue = document.publishedAtUtc == null
      ? '—'
      : DateFormat.yMMMd(
          locale.toLanguageTag(),
        ).format(document.publishedAtUtc!.toLocal());

  final buffer = StringBuffer()
    ..writeln(document.title)
    ..writeln('$versionLabel: ${document.version}')
    ..writeln('$publishedLabel: $publishedValue')
    ..writeln()
    ..writeln(document.summary)
    ..writeln();

  for (final section in document.sections) {
    buffer.writeln(section.heading);
    for (final paragraph in section.paragraphs) {
      buffer.writeln(paragraph);
      buffer.writeln();
    }
  }

  return buffer.toString().trimRight();
}

Future<void> _saveLegalDocumentCopy({
  required BuildContext context,
  required Locale locale,
  required MobileLegalDocument document,
}) async {
  final plainText = _buildLegalDocumentPlainText(
    document: document,
    locale: locale,
  );
  final encoded = utf8.encode(plainText);
  final fileName = sanitizeFileName(
    '${document.kind}_${document.version}',
    fallback: 'petmagic_legal_document',
  );
  final isRu = locale.languageCode.toLowerCase() == 'ru';

  try {
    final saved = await saveBytesToDevice(
      bytes: encoded,
      dialogTitle: isRu ? 'Сохранить копию документа' : 'Save document copy',
      fileName: '$fileName.txt',
      allowedExtensions: const <String>['txt'],
    );

    if (!context.mounted || !saved) {
      return;
    }

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(
          isRu ? 'Копия документа сохранена.' : 'Document copy saved.',
        ),
      ),
    );
  } catch (_) {
    if (!context.mounted) {
      return;
    }

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(
          isRu
              ? 'Не удалось сохранить копию документа.'
              : 'Unable to save document copy.',
        ),
      ),
    );
  }
}

Future<void> _shareLegalDocumentCopy({
  required Locale locale,
  required MobileLegalDocument document,
}) {
  final plainText = _buildLegalDocumentPlainText(
    document: document,
    locale: locale,
  );

  return SharePlus.instance.share(ShareParams(text: plainText));
}

