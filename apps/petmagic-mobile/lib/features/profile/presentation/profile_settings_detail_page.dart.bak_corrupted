MobileLinkedAccount? _findLinkedAccount(
  List<MobileLinkedAccount> accounts,
  ExternalAuthProvider provider,
) {
  for (final account in accounts) {
    if (account.provider.toLowerCase() == provider.apiValue.toLowerCase()) {
      return account;
    }
  }

  return null;
}

