  MobileLegalDocument? _documentFromAsync(
    ProfileSettingsDetailKind kind,
    AsyncValue<MobileLegalDocuments> value,
  ) {
    return switch (value) {
      AsyncData(:final value) => _documentFromValue(kind, value),
      _ => null,
    };
  }

  MobileLegalDocument _documentFromValue(
    ProfileSettingsDetailKind kind,
    MobileLegalDocuments value,
  ) {
    return kind == ProfileSettingsDetailKind.terms
        ? value.termsOfUse
        : value.privacyPolicy;
  }

  String _formatDate(DateTime? value, Locale locale) {
    if (value == null) {
      return '—';
    }

    return DateFormat.yMMMd(
      locale.toLanguageTag(),
    ).add_Hm().format(value.toLocal());
  }

  List<String> _buildChangesHints({
    required Locale locale,
    required ProfileSettingsDetailKind kind,
    required MobileUserProfile? profile,
    required MobileLegalDocument document,
  }) {
    final acceptedVersion = kind == ProfileSettingsDetailKind.terms
        ? profile?.legalAcceptance.termsOfUseAcceptedVersion
        : profile?.legalAcceptance.privacyPolicyAcceptedVersion;
    final hasNewVersion =
        acceptedVersion != null &&
        acceptedVersion.isNotEmpty &&
        acceptedVersion != document.version;
    final isRu = locale.languageCode.toLowerCase() == 'ru';

    if (hasNewVersion) {
      return [
        isRu
            ? 'Опубликована новая версия ${document.version} (принятая: $acceptedVersion).'
            : 'A newer version ${document.version} is published (accepted: $acceptedVersion).',
        isRu
            ? 'Проверьте обновленные условия перед следующим действием в приложении.'
            : 'Review the updated terms before your next action in the app.',
      ];
    }

    return [
      isRu
          ? 'После принятия новых изменений не зафиксировано.'
          : 'No new changes were published after your acceptance.',
      isRu
          ? 'Текущая публикация: ${_formatDate(document.publishedAtUtc, locale)}.'
          : 'Current publication date: ${_formatDate(document.publishedAtUtc, locale)}.',
    ];
  }
