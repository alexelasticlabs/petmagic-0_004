default_platform(:ios)

platform :android do
  desc "Upload an existing signed AAB to Play Internal"
  lane :upload_internal do
    supply(
      aab: ENV.fetch("AAB_PATH"),
      package_name: ENV.fetch("GOOGLE_PLAY_PACKAGE_NAME"),
      track: "internal",
      release_status: "completed",
      json_key: ENV.fetch("GOOGLE_PLAY_JSON_KEY_PATH"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote an already uploaded Play release without rebuilding"
  lane :promote do
    supply(
      package_name: ENV.fetch("GOOGLE_PLAY_PACKAGE_NAME"),
      track: ENV.fetch("SOURCE_TRACK", "internal"),
      track_promote_to: ENV.fetch("TARGET_TRACK"),
      version_code: ENV.fetch("VERSION_CODE").to_i,
      rollout: ENV.fetch("ROLLOUT", "1.0"),
      json_key: ENV.fetch("GOOGLE_PLAY_JSON_KEY_PATH"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  private_lane :app_store_api_key_from_env do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8"),
      is_key_content_base64: false
    )
  end

  desc "Synchronize App Store signing assets using Match"
  lane :sync_signing do
    match_readonly = ENV.fetch("MATCH_READONLY", "true") == "true"
    bundle_identifier = ENV.fetch("APP_STORE_BUNDLE_ID")
    setup_ci
    # setup_ci correctly prepares an ephemeral keychain, but also switches
    # Match to readonly mode. Preserve the workflow's explicit bootstrap
    # decision after the CI setup has completed.
    ENV["MATCH_READONLY"] = match_readonly.to_s
    match(
      type: "appstore",
      readonly: match_readonly,
      app_identifier: [bundle_identifier],
      api_key: app_store_api_key_from_env
    )
    update_project_provisioning(
      xcodeproj: "ios/Runner.xcodeproj",
      profile: ENV.fetch("sigh_#{bundle_identifier}_appstore_profile-path"),
      target_filter: "^Runner$",
      build_configuration: "^Release-production$",
      code_signing_identity: "Apple Distribution"
    )
  end

  desc "Upload an existing IPA to TestFlight"
  lane :upload_testflight do
    pilot(
      ipa: ENV.fetch("IPA_PATH"),
      api_key: app_store_api_key_from_env,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Read the latest processed TestFlight build for one marketing version"
  lane :testflight_status do
    version = ENV.fetch("APP_VERSION")
    latest_build = latest_testflight_build_number(
      version: version,
      api_key: app_store_api_key_from_env,
      initial_build_number: 0
    )
    UI.message("TESTFLIGHT_LATEST_BUILD=#{latest_build}")
  end

  desc "Read the App Store product catalog required by the iOS checkout flows"
  lane :catalog_status do
    sh(
      "ruby",
      File.expand_path("app_store_catalog_status.rb", __dir__)
    )
  end

  desc "Prepare private TestFlight groups for an existing processed build"
  lane :prepare_testflight_groups do
    sh(
      "ruby",
      File.expand_path("testflight_distribution.rb", __dir__)
    )
  end

  desc "Submit an existing TestFlight build without uploading a new binary"
  lane :promote do
    deliver(
      api_key: app_store_api_key_from_env,
      app_identifier: ENV.fetch("APP_STORE_BUNDLE_ID"),
      build_number: ENV.fetch("BUILD_NUMBER"),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: ENV.fetch("SUBMIT_FOR_REVIEW", "false") == "true",
      automatic_release: false,
      phased_release: true,
      force: true
    )
  end
end
