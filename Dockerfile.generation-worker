# syntax=docker/dockerfile:1.7
FROM mcr.microsoft.com/dotnet/sdk:10.0.300@sha256:c0790639332692a0d56cdd81ed581cfd24d040d9839764c138994866df89a3b6 AS builder
ARG TARGETARCH
ARG NUGET_CACHE_BUST=default
WORKDIR /src
COPY ["global.json", "./"]
COPY ["Directory.Build.props", "./"]
COPY ["Directory.Packages.props", "./"]
COPY ["shared/", "shared/"]
COPY ["src/", "src/"]
RUN --mount=type=cache,id=nuget-generation-worker-${NUGET_CACHE_BUST},sharing=locked,target=/root/.nuget/packages \
    case "$TARGETARCH" in \
      amd64) RID=linux-x64 ;; \
      arm64) RID=linux-arm64 ;; \
      *) echo "Unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && dotnet restore "src/Host/PetMagic.Host.GenerationWorker/PetMagic.Host.GenerationWorker.csproj" \
      -r "$RID" \
      -p:PublishReadyToRun=true \
      --verbosity normal
RUN --mount=type=cache,id=nuget-generation-worker-${NUGET_CACHE_BUST},sharing=locked,target=/root/.nuget/packages \
    case "$TARGETARCH" in \
      amd64) RID=linux-x64 ;; \
      arm64) RID=linux-arm64 ;; \
      *) echo "Unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && dotnet publish "src/Host/PetMagic.Host.GenerationWorker/PetMagic.Host.GenerationWorker.csproj" \
      -c Release \
      --no-restore \
      -r "$RID" \
      --self-contained false \
      -o /app/publish \
      -p:PublishReadyToRun=true

FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:a4556ed033fa96f984bb7a8d348851cb2d36b1281dd2420070045f664fbb5f94
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o APT::Update::Error-Mode=any update \
    && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y --no-install-recommends libgssapi-krb5-2 ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -r appuser
WORKDIR /app
COPY --from=builder /app/publish .
COPY scripts/docker/run-dotnet-app.sh /usr/local/bin/run-dotnet-app.sh
RUN chmod +x /usr/local/bin/run-dotnet-app.sh
RUN mkdir -p /app/wwwroot/templates-media \
    && chown -R appuser:appuser /app
ENV APP_DLL=PetMagic.Host.GenerationWorker.dll
ENV APP_VOLUME_DIRS="/app/wwwroot/templates-media"
ENTRYPOINT ["/usr/local/bin/run-dotnet-app.sh"]
