# syntax=docker/dockerfile:1.7
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS builder
ARG TARGETARCH
ARG NUGET_CACHE_BUST=default
WORKDIR /src
COPY ["global.json", "./"]
COPY ["Directory.Build.props", "./"]
COPY ["Directory.Packages.props", "./"]
COPY ["shared/", "shared/"]
COPY ["src/", "src/"]
RUN --mount=type=cache,id=nuget-api-${NUGET_CACHE_BUST},sharing=locked,target=/root/.nuget/packages \
    case "$TARGETARCH" in \
      amd64) RID=linux-x64 ;; \
      arm64) RID=linux-arm64 ;; \
      *) echo "Unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && dotnet restore "src/Host/PetMagic.Host.Api/PetMagic.Host.Api.csproj" \
      -r "$RID" \
      -p:PublishReadyToRun=true \
      --verbosity normal
RUN --mount=type=cache,id=nuget-api-${NUGET_CACHE_BUST},sharing=locked,target=/root/.nuget/packages \
    case "$TARGETARCH" in \
      amd64) RID=linux-x64 ;; \
      arm64) RID=linux-arm64 ;; \
      *) echo "Unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && dotnet publish "src/Host/PetMagic.Host.Api/PetMagic.Host.Api.csproj" \
      -c Release \
      --no-restore \
      -r "$RID" \
      --self-contained false \
      -o /app/publish \
      -p:PublishReadyToRun=true

FROM mcr.microsoft.com/dotnet/aspnet:10.0
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o APT::Update::Error-Mode=any update \
    && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y --no-install-recommends libgssapi-krb5-2 curl ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -r appuser
WORKDIR /app
COPY --from=builder /app/publish .
COPY scripts/docker/run-dotnet-app.sh /usr/local/bin/run-dotnet-app.sh
RUN chmod +x /usr/local/bin/run-dotnet-app.sh
RUN mkdir -p /app/wwwroot/support-attachments /app/wwwroot/user-avatars /app/wwwroot/templates-media \
    && mkdir -p /home/appuser/.aspnet/DataProtection-Keys \
    && chown -R appuser:appuser /app /home/appuser
ENV APP_DLL=PetMagic.Host.Api.dll
ENV APP_VOLUME_DIRS="/app/wwwroot/support-attachments /app/wwwroot/user-avatars /app/wwwroot/templates-media /home/appuser/.aspnet/DataProtection-Keys"
EXPOSE 5000
ENTRYPOINT ["/usr/local/bin/run-dotnet-app.sh"]
