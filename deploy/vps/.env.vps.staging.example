# Isolated staging environment. Never copy production values into this file.
ASPNETCORE_ENVIRONMENT=Staging
DOTNET_ENVIRONMENT=Staging
SOURCE_REVISION=__EXISTING_VPS_IMAGE_TAG__
DOCKER_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=15001

POSTGRES_PASSWORD=__GENERATE_UNIQUE_SECRET__
JWT_SIGNING_KEY=__GENERATE_UNIQUE_SECRET__
DATA_PROTECTION_CERTIFICATE_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=PetMagic Staging Admin

BACKEND_PUBLIC_BASE_URL=https://api.staging.petgpt.app
BACKEND_ALLOWED_HOSTS=api.staging.petgpt.app;backend
BACKEND_HEALTHCHECK_HOST=api.staging.petgpt.app
CORS_ALLOWED_ORIGIN=https://admin.staging.petgpt.app
NEXT_PUBLIC_API_BASE_URL=https://api.staging.petgpt.app
INTERNAL_API_BASE_URL=http://backend:5000
PETMAGIC_APP_DEEP_LINK_SCHEME=petmagic
EXTERNAL_AUTH_MOBILE_REDIRECT_SCHEME=petmagic

# Keep generation providers isolated from production. The worker is deliberately disabled by default.
TEMPLATES_STORAGE_PROVIDER=Local
TEMPLATES_AI_PROVIDER=Fake
TEMPLATES_WATERMARK_ENABLED=false
PETMAGIC_QA_FIXTURES_ENABLED=false
PETMAGIC_LOCAL_SMOKE_FAST_FAKE_COMPLETION=false
GENERATION_SCHEDULER_V2_ENABLED=false

# Test-only Stripe credentials and its staging webhook signing secret.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=petmagic://checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=petmagic://checkout/cancel
STRIPE_BILLING_PORTAL_RETURN_URL=https://admin.staging.petgpt.app/payments/return

# Staging deliberately does not receive production store, OAuth, Firebase, SMTP, R2, or fal.ai credentials.
GOOGLE_PLAY_ENVIRONMENT=sandbox
APP_STORE_ENVIRONMENT=sandbox
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_SSL=false
EMAIL_FROM_ADDRESS=no-reply@staging.petgpt.app
EMAIL_FROM_NAME=PetMagic Staging
# Mailpit is intentionally local-only. Enable the worker only after a real
# staging SMTP relay with TLS and dedicated credentials is configured.
Email__DispatchWorkerEnabled=false
FORWARDED_HEADERS_ENABLED=true
FORWARDED_HEADERS_TRUST_ALL=true
STORE_ACCOUNT_BINDING_MODE=compatibility

# Required by the root Compose model even though monitoring profiles stay off.
GRAFANA_ADMIN_PASSWORD=__MONITORING_DISABLED__
ALERTMANAGER_WEBHOOK_URL=https://localhost.invalid/monitoring-disabled
