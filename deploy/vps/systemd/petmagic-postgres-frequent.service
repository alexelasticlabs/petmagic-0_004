[Unit]
Description=PetMagic online PostgreSQL off-site backup
After=petmagic-compose.service
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=oneshot
User=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/bin/python3 /opt/petmagic/shared/operations/postgres-backups.py backup
TimeoutStartSec=10min
Restart=on-failure
RestartSec=60
