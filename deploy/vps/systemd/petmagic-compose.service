[Unit]
Description=PetMagic Docker Compose stack
Requires=docker.service
PartOf=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=all
RuntimeDirectory=petmagic
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
WorkingDirectory=/opt/petmagic/current
ExecStartPre=/usr/bin/bash /opt/petmagic/current/deploy/vps/scripts/runtime-preflight.sh
ExecStart=/usr/bin/bash /opt/petmagic/current/deploy/vps/scripts/supervise-stack.sh
ExecStop=-/usr/bin/bash /opt/petmagic/current/deploy/vps/scripts/stop-stack.sh
ExecStopPost=-/usr/bin/bash /opt/petmagic/current/deploy/vps/scripts/stop-stack.sh
Restart=on-failure
RestartSec=5
WatchdogSec=60
TimeoutAbortSec=30
TimeoutStartSec=480
TimeoutStopSec=480

[Install]
WantedBy=multi-user.target
