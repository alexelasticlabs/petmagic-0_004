[Unit]
Description=PetMagic PostgreSQL and API-data off-site backup
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/petmagic/shared/backups/render-restore.marker

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/petmagic/current
Environment=PETMAGIC_POSTGRES_BACKUP_RETENTION_DAYS=14
Environment=PETMAGIC_API_DATA_BACKUP_RETENTION_DAYS=14
ExecStart=/usr/bin/bash /opt/petmagic/current/deploy/vps/scripts/backup-offsite.sh
