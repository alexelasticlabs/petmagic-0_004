[Unit]
Description=Verify PetMagic off-site PostgreSQL backup by isolated restore
After=petmagic-compose.service

[Service]
Type=oneshot
User=root
UMask=0077
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/bin/python3 /opt/petmagic/shared/operations/postgres-backups.py verify
TimeoutStartSec=45min
TimeoutStopSec=120
