# Canonical local Docker Compose environment template.
# Copy to the ignored root .env for local development and replace placeholders.
# Staging/production deployment configuration is declared in render.yaml and
# render.production.yaml; do not use this file as a deployment secret store.
# Never paste real production/stage credentials into .env.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
SOURCE_REVISION=local

# PostgreSQL Configuration
# If you change this after the postgres_data volume was initialized, update the
# database user password manually or recreate the local Docker volume.
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_HOST_PORT=5432
DATABASE_MAX_POOL_SIZE=28
DATABASE_PEER_MAX_POOL_SIZE=24
WORKER_DATABASE_MAX_POOL_SIZE=24
WORKER_DATABASE_PEER_MAX_POOL_SIZE=28
DATABASE_OPERATIONAL_RESERVE_CONNECTIONS=16

# Docker host port bindings
# Keep local services on loopback. Set 0.0.0.0 only for an explicitly secured LAN workflow.
DOCKER_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=5001
ADMIN_WEB_HOST_PORT=3000
ADMIN_MEDIA_ORIGINS=
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3001
TEMPO_HOST_PORT=3200

# Docker resource limits
BACKEND_MEMORY_LIMIT=768m
BACKEND_CPUS=1.0
GENERATION_WORKER_MEMORY_LIMIT=768m
GENERATION_WORKER_CPUS=1.0
PETMAGIC_QA_FIXTURES_ENABLED=false

# Template generation queue/worker
GENERATION_SCHEDULER_V2_ENABLED=false
GENERATION_WORKER_POLL_INTERVAL_MS=500
GENERATION_DISPATCH_CONCURRENCY=4
GENERATION_PROVIDER_RECONCILIATION_CONCURRENCY=4
GENERATION_MEDIA_IMPORT_CONCURRENCY=1
GENERATION_MAINTENANCE_CONCURRENCY=1
GENERATION_GLOBAL_MAX_CONCURRENT=3
GENERATION_IMAGE_RESERVED_CONCURRENT=0
GENERATION_IMAGE_PROTECTED_CONCURRENT=0
GENERATION_IMAGE_MAX_CONCURRENT=2
GENERATION_VIDEO_RESERVED_CONCURRENT=0
GENERATION_VIDEO_MAX_CONCURRENT=1
GENERATION_VIDEO_BORROW_MAX_CONCURRENT=0
GENERATION_ENABLE_ELASTIC_LANE_BORROWING=false
GENERATION_ALLOW_VIDEO_BORROW_WHEN_IMAGE_QUEUE_EMPTY=true
GENERATION_ALLOW_VIDEO_BORROW_IMAGE_WAIT_BELOW_SECONDS=120
GENERATION_VIDEO_BORROW_RELEASE_MODE=natural_completion
GENERATION_BORROWED_VIDEO_MAX_AGE_SECONDS=0
GENERATION_BORROWING_PRIORITY_TIERS=premium,privileged,admin,free
GENERATION_VIDEO_PREPROCESSING_MAX_CONCURRENT=1
FAL_PROVIDER_CONCURRENCY_LIMIT=0
FAL_PROVIDER_RESERVED_CONCURRENCY=1
FAL_CANCEL_MAX_ATTEMPTS=3
FAL_PROVIDER_BALANCE_LOW_THRESHOLD_USD=10
FAL_PROVIDER_BALANCE_CRITICAL_THRESHOLD_USD=5
FAL_PROVIDER_SPEND_DAILY_LIMIT_USD=0
GENERATION_PROVIDER_MAX_RPM=60
GENERATION_MAX_ATTEMPTS=3
GENERATION_JOB_LOCK_TIMEOUT_MS=900000
GENERATION_PROVIDER_RECONCILIATION_CLAIM_LEASE_MS=90000
GENERATION_ORPHAN_QUEUED_TIMEOUT_MS=120000
GENERATION_REFUND_RETRY_DELAY_MS=30000
GENERATION_QUEUE_MAX_SIZE=1000
GENERATION_ESTIMATED_VIDEO_SECONDS=420
GENERATION_ESTIMATED_IMAGE_SECONDS=90
GENERATION_ESTIMATED_VIDEO_PREPROCESSING_SECONDS=90
GENERATION_FREE_IMAGE_MAX_WAIT_SECONDS=1800
GENERATION_PREMIUM_IMAGE_MAX_WAIT_SECONDS=900
GENERATION_PRIVILEGED_IMAGE_MAX_WAIT_SECONDS=900
GENERATION_FREE_VIDEO_MAX_WAIT_SECONDS=3600
GENERATION_PREMIUM_VIDEO_MAX_WAIT_SECONDS=1800
GENERATION_PRIVILEGED_VIDEO_MAX_WAIT_SECONDS=1800
GENERATION_PRIORITY_AGING_INTERVAL_SECONDS=60
GENERATION_PRIORITY_AGING_BOOST=500
GENERATION_CANCEL_QUEUED_ENABLED=true
TEMPLATES_REALTIME_EVENT_RETENTION_MINUTES=60
TEMPLATES_REALTIME_EVENT_CLEANUP_INTERVAL_MINUTES=10
TEMPLATES_REALTIME_EVENT_CLEANUP_BATCH_SIZE=1000
TEMPLATES_WATERMARK_ENABLED=false
# Local examples keep this disabled because the template catalog is usually empty.
# Enable explicitly in the API host env when Template of the Day auto-pick should run.
TEMPLATES_TEMPLATE_OF_THE_DAY_AUTO_PICK_WORKER_ENABLED=false

# Backend rate limits
RATE_LIMIT_AUTH_PERMIT=30
RATE_LIMIT_ECONOMY_PERMIT=60
RATE_LIMIT_TEMPLATES_PERMIT=90
RATE_LIMIT_GENERATION_CREATE_PERMIT=12
RATE_LIMIT_GENERATION_STATUS_PERMIT=180
RATE_LIMIT_SUPPORT_CHAT_PERMIT=60
RATE_LIMIT_ADMIN_PERMIT=120
RATE_LIMIT_WEBHOOKS_PERMIT=120
RATE_LIMIT_AUTH_REGISTER_PERMIT=8
RATE_LIMIT_AUTH_PASSWORD_RESET_PERMIT=10

# Production-like fal.ai scheduler profiles. Apply these in deployment env only.
# Keep API and GenerationWorker queue/cap/wait values identical.
# Current verified dashboard limit on 2026-07-01: 10, so staging should use FalConcurrency10.
# Production must set the same values explicitly in its secret/env store before rollout.
# FalConcurrency10: global=8 image_reserved=3 image_protected=3 image_max=7 video_reserved=2 video_max=4 video_borrow=2 worker_jobs=2 worker_replicas=4 provider_limit=10 reserved=2
# FalConcurrency20: global=16 image_reserved=6 image_protected=4 image_max=14 video_reserved=4 video_max=9 video_borrow=5 worker_jobs=4 worker_replicas>=4
# FalConcurrency30: global=24 image_reserved=8 image_protected=6 image_max=21 video_reserved=5 video_max=14 video_borrow=9 worker_jobs=4 worker_replicas>=6
#   waits: free_image=2700 premium_image=1200 free_video=5400 premium_video=2700
# FalConcurrency40: global=32 image_reserved=12 image_protected=8 image_max=28 video_reserved=8 video_max=20 video_borrow=12 worker_jobs=4 worker_replicas>=8
#   waits: free_image=3600 premium_image=1500 free_video=7200 premium_video=3600
#
# FalConcurrency10 deployment env:
# GENERATION_GLOBAL_MAX_CONCURRENT=8
# GENERATION_IMAGE_RESERVED_CONCURRENT=3
# GENERATION_IMAGE_PROTECTED_CONCURRENT=3
# GENERATION_IMAGE_MAX_CONCURRENT=7
# GENERATION_VIDEO_RESERVED_CONCURRENT=2
# GENERATION_VIDEO_MAX_CONCURRENT=4
# GENERATION_VIDEO_BORROW_MAX_CONCURRENT=2
# GENERATION_ENABLE_ELASTIC_LANE_BORROWING=true
# GENERATION_ALLOW_VIDEO_BORROW_WHEN_IMAGE_QUEUE_EMPTY=true
# GENERATION_ALLOW_VIDEO_BORROW_IMAGE_WAIT_BELOW_SECONDS=120
# GENERATION_VIDEO_BORROW_RELEASE_MODE=natural_completion
# GENERATION_BORROWED_VIDEO_MAX_AGE_SECONDS=0
# GENERATION_BORROWING_PRIORITY_TIERS=premium,privileged,admin,free
# GENERATION_DISPATCH_CONCURRENCY=4
# GENERATION_PROVIDER_RECONCILIATION_CONCURRENCY=4
# GENERATION_MEDIA_IMPORT_CONCURRENCY=1
# GENERATION_MAINTENANCE_CONCURRENCY=1
# GENERATION_FREE_IMAGE_MAX_WAIT_SECONDS=1800
# GENERATION_PREMIUM_IMAGE_MAX_WAIT_SECONDS=900
# GENERATION_PRIVILEGED_IMAGE_MAX_WAIT_SECONDS=900
# GENERATION_FREE_VIDEO_MAX_WAIT_SECONDS=3600
# GENERATION_PREMIUM_VIDEO_MAX_WAIT_SECONDS=1800
# GENERATION_PRIVILEGED_VIDEO_MAX_WAIT_SECONDS=1800
# FAL_PROVIDER_CONCURRENCY_LIMIT=10
# FAL_PROVIDER_RESERVED_CONCURRENCY=2

# JWT Configuration
# Generate with: openssl rand -base64 64
# Required by docker compose; leave empty only in this example file.
JWT_SIGNING_KEY=replace_with_local_64_byte_base64_key

# Data Protection certificate (local development only)
# Used to encrypt ASP.NET Core Data Protection keys in Development.
DATA_PROTECTION_CERTIFICATE_PASSWORD=replace_with_local_data_protection_password

# Bootstrap Admin User (local development only)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_local_admin_password
BOOTSTRAP_ADMIN_DISPLAY_NAME=PetMagic Admin

# Backend API used by local Docker Compose.
# NEXT_PUBLIC_* values are bundled into the browser. Staging and production
# values belong to render.yaml / render.production.yaml, never to this file.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001
INTERNAL_API_BASE_URL=http://backend:5000
BACKEND_PUBLIC_BASE_URL=http://localhost:5001
BACKEND_ALLOWED_HOSTS=localhost;127.0.0.1;[::1];backend
# Host header used by the container healthcheck. Must be present in BACKEND_ALLOWED_HOSTS.
BACKEND_HEALTHCHECK_HOST=localhost
# Used by deploy/vps/compose.vps.yaml. Set to the HTTPS admin origin on the VPS.
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Required only because the Dockerized admin build runs Next in production mode
# while intentionally targeting the local HTTP backend. Keep false outside local Compose.
ADMIN_WEB_ALLOW_LOCALHOST_API_BASE_URL_IN_PRODUCTION=true
# Set to http://otel-collector:4317 only when running docker compose with --profile monitoring.
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_local_grafana_password
ALERTMANAGER_WEBHOOK_URL=https://alerts.petmagic.app/petmagic-alerts

# Stripe payments (optional for local development; live/store values are required for production billing)
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# Recurring live Prices for the two Premium plans. Keep the Stripe IDs only in
# protected environment configuration, never in source control.
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/payments/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/payments/cancel
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:3000/payments/return
# Exact app scheme used by the admin payment bridge when returning to mobile.
PETMAGIC_APP_DEEP_LINK_SCHEME=petmagic
# Production URLs are configured through the production Blueprint and platform
# secret/configuration store; do not copy them into local .env.

# Store billing providers (required for production app-store purchase validation)
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY_PEM=
GOOGLE_PLAY_ENVIRONMENT=production
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_EXPECTED_EMAIL=
GOOGLE_PLAY_PACKAGE_NAME=com.petmagic.app
GOOGLE_PLAY_PREMIUM_MONTHLY_PRODUCT_ID=com.petmagic.app.premium.monthly
GOOGLE_PLAY_PREMIUM_YEARLY_PRODUCT_ID=com.petmagic.app.premium.yearly
APP_STORE_SHARED_SECRET=
APP_STORE_ENVIRONMENT=production
APP_STORE_BUNDLE_ID=com.petmagic.app
APP_STORE_PREMIUM_MONTHLY_PRODUCT_ID=com.petmagic.app.premium.monthly
APP_STORE_PREMIUM_YEARLY_PRODUCT_ID=com.petmagic.app.premium.yearly
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
TEMPLATES_FIREBASE_PUSH_ENABLED=false
ECONOMY_FIREBASE_PUSH_ENABLED=false
STORE_ACCOUNT_BINDING_MODE=compatibility
FORWARDED_HEADERS_ENABLED=false
FORWARDED_HEADERS_TRUST_ALL=false

# FAL AI generation (required for real template generation)
TEMPLATES_STORAGE_PROVIDER=Local
TEMPLATES_AI_PROVIDER=Fake
PETMAGIC_LOCAL_SMOKE_FAST_FAKE_COMPLETION=true
FAL_AI_API_KEY=
FAL_WEBHOOK_URL=

# Cloudflare R2 storage (required for real media storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional: External OAuth Providers
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are the Web application credentials
# used by the backend for native mobile Google sign-in exchange and browser fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated accepted Google ID token audiences. Include Web/iOS/Android OAuth client IDs per environment.
GOOGLE_AUDIENCES=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Optional comma-separated accepted Apple identity token audiences. Include Bundle ID and Services ID as needed per environment.
APPLE_AUDIENCES=
# Exact mobile callback scheme accepted by the local/Compose backend.
EXTERNAL_AUTH_MOBILE_REDIRECT_SCHEME=petmagic
APPLE_AUTHORIZATION_ENDPOINT=https://appleid.apple.com/auth/authorize
APPLE_TOKEN_ENDPOINT=https://appleid.apple.com/auth/token

# SMTP email delivery for confirmation and password reset.
# Local Docker uses Mailpit: open http://localhost:8025 to read messages.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_SSL=false
EMAIL_FROM_ADDRESS=no-reply@petmagic.app
EMAIL_FROM_NAME=PetMagic
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_WEB_HOST_PORT=8025
