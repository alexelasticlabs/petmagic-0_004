# Environment template
# Copy to .env for local development and replace placeholders.
# Never paste real production/stage credentials into .env.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# PostgreSQL Configuration
# If you change this after the postgres_data volume was initialized, update the
# database user password manually or recreate the local Docker volume.
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_HOST_PORT=5432

# Docker host port bindings
BACKEND_HOST_PORT=5001
ADMIN_WEB_HOST_PORT=3000

# Template generation queue/worker
GENERATION_WORKER_MAX_CONCURRENT_JOBS=1
GENERATION_GLOBAL_MAX_CONCURRENT=3
GENERATION_IMAGE_RESERVED_CONCURRENT=0
GENERATION_IMAGE_PROTECTED_CONCURRENT=0
GENERATION_IMAGE_MAX_CONCURRENT=2
GENERATION_VIDEO_RESERVED_CONCURRENT=0
GENERATION_VIDEO_MAX_CONCURRENT=1
GENERATION_VIDEO_BORROW_MAX_CONCURRENT=0
GENERATION_ENABLE_ELASTIC_LANE_BORROWING=false
GENERATION_ALLOW_VIDEO_BORROW_WHEN_IMAGE_QUEUE_EMPTY=true
GENERATION_ALLOW_VIDEO_BORROW_IMAGE_WAIT_BELOW_SECONDS=120
GENERATION_VIDEO_BORROW_RELEASE_MODE=natural_completion
GENERATION_BORROWED_VIDEO_MAX_AGE_SECONDS=0
GENERATION_BORROWING_PRIORITY_TIERS=premium,privileged,admin,free
GENERATION_VIDEO_PREPROCESSING_MAX_CONCURRENT=1
FAL_PROVIDER_CONCURRENCY_LIMIT=0
FAL_PROVIDER_RESERVED_CONCURRENCY=1
FAL_PROVIDER_BALANCE_LOW_THRESHOLD_USD=100
FAL_PROVIDER_BALANCE_CRITICAL_THRESHOLD_USD=25
FAL_PROVIDER_SPEND_DAILY_LIMIT_USD=0
GENERATION_PROVIDER_MAX_RPM=60
GENERATION_MAX_ATTEMPTS=3
GENERATION_JOB_LOCK_TIMEOUT_MS=900000
GENERATION_ORPHAN_QUEUED_TIMEOUT_MS=120000
GENERATION_QUEUE_MAX_SIZE=1000
GENERATION_ESTIMATED_VIDEO_SECONDS=420
GENERATION_ESTIMATED_IMAGE_SECONDS=90
GENERATION_ESTIMATED_VIDEO_PREPROCESSING_SECONDS=90
GENERATION_FREE_IMAGE_MAX_WAIT_SECONDS=1800
GENERATION_PREMIUM_IMAGE_MAX_WAIT_SECONDS=600
GENERATION_PRIVILEGED_IMAGE_MAX_WAIT_SECONDS=600
GENERATION_FREE_VIDEO_MAX_WAIT_SECONDS=3600
GENERATION_PREMIUM_VIDEO_MAX_WAIT_SECONDS=1800
GENERATION_PRIVILEGED_VIDEO_MAX_WAIT_SECONDS=1800
GENERATION_PRIORITY_AGING_INTERVAL_SECONDS=60
GENERATION_PRIORITY_AGING_BOOST=500
GENERATION_CANCEL_QUEUED_ENABLED=true
TEMPLATES_REALTIME_EVENT_RETENTION_MINUTES=60
TEMPLATES_REALTIME_EVENT_CLEANUP_INTERVAL_MINUTES=10
TEMPLATES_REALTIME_EVENT_CLEANUP_BATCH_SIZE=1000

# Production-like fal.ai scheduler profiles. Apply these in deployment env only.
# Keep API and GenerationWorker queue/cap/wait values identical.
# Current verified dashboard limit on 2026-07-01: 10, so staging should use FalConcurrency10.
# Production must set the same values explicitly in its secret/env store before rollout.
# FalConcurrency10: global=8 image_reserved=3 image_protected=3 image_max=7 video_reserved=2 video_max=4 video_borrow=2 worker_jobs=2 worker_replicas=4 provider_limit=10 reserved=2
# FalConcurrency20: global=16 image_reserved=6 image_protected=4 image_max=14 video_reserved=4 video_max=9 video_borrow=5 worker_jobs=4 worker_replicas>=4
# FalConcurrency30: global=24 image_reserved=8 image_protected=6 image_max=21 video_reserved=5 video_max=14 video_borrow=9 worker_jobs=4 worker_replicas>=6
#   waits: free_image=2700 premium_image=1200 free_video=5400 premium_video=2700
# FalConcurrency40: global=32 image_reserved=12 image_protected=8 image_max=28 video_reserved=8 video_max=20 video_borrow=12 worker_jobs=4 worker_replicas>=8
#   waits: free_image=3600 premium_image=1500 free_video=7200 premium_video=3600
#
# FalConcurrency10 deployment env:
# GENERATION_GLOBAL_MAX_CONCURRENT=8
# GENERATION_IMAGE_RESERVED_CONCURRENT=3
# GENERATION_IMAGE_PROTECTED_CONCURRENT=3
# GENERATION_IMAGE_MAX_CONCURRENT=7
# GENERATION_VIDEO_RESERVED_CONCURRENT=2
# GENERATION_VIDEO_MAX_CONCURRENT=4
# GENERATION_VIDEO_BORROW_MAX_CONCURRENT=2
# GENERATION_ENABLE_ELASTIC_LANE_BORROWING=true
# GENERATION_ALLOW_VIDEO_BORROW_WHEN_IMAGE_QUEUE_EMPTY=true
# GENERATION_ALLOW_VIDEO_BORROW_IMAGE_WAIT_BELOW_SECONDS=120
# GENERATION_VIDEO_BORROW_RELEASE_MODE=natural_completion
# GENERATION_BORROWED_VIDEO_MAX_AGE_SECONDS=0
# GENERATION_BORROWING_PRIORITY_TIERS=premium,privileged,admin,free
# GENERATION_WORKER_MAX_CONCURRENT_JOBS=2
# GENERATION_FREE_IMAGE_MAX_WAIT_SECONDS=1800
# GENERATION_PREMIUM_IMAGE_MAX_WAIT_SECONDS=900
# GENERATION_PRIVILEGED_IMAGE_MAX_WAIT_SECONDS=900
# GENERATION_FREE_VIDEO_MAX_WAIT_SECONDS=3600
# GENERATION_PREMIUM_VIDEO_MAX_WAIT_SECONDS=1800
# GENERATION_PRIVILEGED_VIDEO_MAX_WAIT_SECONDS=1800
# FAL_PROVIDER_CONCURRENCY_LIMIT=10
# FAL_PROVIDER_RESERVED_CONCURRENCY=2

# JWT Configuration
# Generate with: openssl rand -base64 64
# Required by docker compose; leave empty only in this example file.
JWT_SIGNING_KEY=replace_with_local_64_byte_base64_key

# Data Protection certificate (local development only)
# Used to encrypt ASP.NET Core Data Protection keys in Development.
DATA_PROTECTION_CERTIFICATE_PASSWORD=replace_with_local_data_protection_password

# Bootstrap Admin User (local development only)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_local_admin_password
BOOTSTRAP_ADMIN_DISPLAY_NAME=PetMagic Admin

# Backend API (used by frontend)
# NEXT_PUBLIC_* values are bundled into the browser. Use HTTPS staging/prod URLs
# for any production admin build. For local dev only, override with
# http://localhost:5001 in your uncommitted .env.
NEXT_PUBLIC_API_BASE_URL=https://api.petmagic.app
INTERNAL_API_BASE_URL=https://api.petmagic.app
BACKEND_PUBLIC_BASE_URL=https://api.petmagic.app

# Stripe payments (optional for local development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=https://admin.petmagic.app/payments/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://admin.petmagic.app/payments/cancel
STRIPE_BILLING_PORTAL_RETURN_URL=https://admin.petmagic.app/ru/templates/image
# Local dev URL examples:
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/payments/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/payments/cancel
# STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:3000/ru/templates/image
# Optional per-mode overrides (usually not needed at project start):
# STRIPE_TEST_SECRET_KEY=
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# STRIPE_LIVE_WEBHOOK_SECRET=

# FAL AI generation (required for real template generation)
FAL_AI_API_KEY=
FAL_WEBHOOK_URL=

# Cloudflare R2 storage (required for real media storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional: External OAuth Providers
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are the Web application credentials
# used by the backend for native mobile Google sign-in exchange and browser fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated accepted Google ID token audiences. Include Web/iOS/Android OAuth client IDs per environment.
GOOGLE_AUDIENCES=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Optional comma-separated accepted Apple identity token audiences. Include Bundle ID and Services ID as needed per environment.
APPLE_AUDIENCES=
APPLE_AUTHORIZATION_ENDPOINT=https://appleid.apple.com/auth/authorize
APPLE_TOKEN_ENDPOINT=https://appleid.apple.com/auth/token

# SMTP email delivery for confirmation and password reset.
# Local Docker uses Mailpit: open http://localhost:8025 to read messages.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_SSL=false
EMAIL_FROM_ADDRESS=no-reply@petmagic.app
EMAIL_FROM_NAME=PetMagic
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_WEB_HOST_PORT=8025
