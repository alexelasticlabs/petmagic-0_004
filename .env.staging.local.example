# Staging fal.ai rollout env pack.
# Copy to .env.staging.local only on the runner machine, or mirror these names in
# CI / 1Password / Vault. Do not commit real staging values.
#
# Selected profile on 2026-07-01: FalConcurrency10.
# fal.ai dashboard concurrency: 10.
# GenerationWorker replicas: 4.
# Worker loops: 4 replicas * GENERATION_WORKER_MAX_CONCURRENT_JOBS=2 = 8.

# Staging smoke runner inputs. These are read by scripts/qa/run-staging-generation-scheduler-smoke.mjs.
STAGING_API_BASE_URL=
STAGING_DATABASE_URL=
STAGING_IMAGE_TEMPLATE_ID=
STAGING_VIDEO_TEMPLATE_ID=
STAGING_FAILING_TEMPLATE_ID=
STAGING_FREE_JWT=
STAGING_PREMIUM_JWT=
STAGING_ADMIN_AUTH_TOKEN=
STAGING_PROMETHEUS_BASE_URL=
STAGING_PROMETHEUS_BEARER_TOKEN=
STAGING_API_PROCESS_ID=
STAGING_WORKER_PROCESS_ID=
STAGING_MIGRATION_TOOLING_LABEL=

# Optional staging smoke controls.
STAGING_MIGRATION_LOG_PATH=
STAGING_MIN_EXISTING_GENERATIONS=100
STAGING_FAILING_TEMPLATE_MEDIA_TYPE=image
STAGING_SMOKE_TOTAL=60
STAGING_SUBMIT_CONCURRENCY=8
STAGING_POLL_ATTEMPTS=60
STAGING_POLL_DELAY_MS=1000
STAGING_REALTIME_GROWTH_BUDGET=
STAGING_USE_QA_FIXTURES=false
STAGING_REQUIRED_GENERATION_METRICS=
STAGING_PSQL_COMMAND=psql
STAGING_ARTIFACT_DIR=

# Economy staging infrastructure gate. These are read by
# scripts/qa/run-economy-staging-infra-gate.mjs.
ECONOMY_GATE_RUN_MIGRATIONS=false
ECONOMY_GATE_BACKUP_CONFIRMED=false
ECONOMY_GATE_RUN_RECONCILIATION=false
ECONOMY_GATE_ENV_FILE=
ECONOMY_GATE_RUN_ID=
ECONOMY_GATE_ARTIFACT_DIR=

# Template feed TZ1-8 staging snapshot inputs. These are read by
# scripts/qa/run-template-feed-staging-snapshot.mjs and do not mutate staging by
# themselves.
TEMPLATE_FEED_SNAPSHOT_MODE=all
TEMPLATE_FEED_SNAPSHOT_RUN_ID=
TEMPLATE_FEED_SNAPSHOT_ARTIFACT_DIR=
TEMPLATE_FEED_ROUTE_REGEX=.*(/api/templates/feed|templates.*feed|ListFeedAsync).*
TEMPLATE_FEED_METHOD_REGEX=GET
TEMPLATE_FEED_LATENCY_RATE_WINDOW=5m
TEMPLATE_FEED_BEFORE_AT_UTC=
TEMPLATE_FEED_AFTER_AT_UTC=
TEMPLATE_FEED_MAX_P95_REGRESSION_SECONDS=0
TEMPLATE_FEED_MAX_P99_REGRESSION_SECONDS=0
TEMPLATE_FEED_ALLOW_CURRENT_LATENCY_ONLY=false
TEMPLATE_FEED_PROMETHEUS_BEARER_TOKEN=
TEMPLATE_FEED_PROMETHEUS_HEADERS_JSON=
TEMPLATE_FEED_SSE_WINDOW=15m
TEMPLATE_FEED_SNAPSHOT_WAIT_SECONDS=0
TEMPLATE_FEED_ALLOW_ZERO_WAIT_SSE=false
TEMPLATE_FEED_ADMIN_ACTION_LABELS=text_update,media_update,category_rename
TEMPLATE_FEED_ADMIN_QA_REPORT_PATH=

# API and Worker deployment env, non-secret. Keep these identical in API and
# GenerationWorker unless a line explicitly names one process role.
# API-only role flag:
# Templates__GenerationWorkerEnabled=false
ASPNETCORE_ENVIRONMENT=Staging
DOTNET_ENVIRONMENT=Staging
TEMPLATES_STORAGE_PROVIDER=R2
TEMPLATES_AI_PROVIDER=Fal
TEMPLATES_WATERMARK_ENABLED=true
PETMAGIC_LOCAL_SMOKE_FAST_FAKE_COMPLETION=false
GENERATION_GLOBAL_MAX_CONCURRENT=8
GENERATION_IMAGE_RESERVED_CONCURRENT=3
GENERATION_IMAGE_PROTECTED_CONCURRENT=3
GENERATION_IMAGE_MAX_CONCURRENT=7
GENERATION_VIDEO_RESERVED_CONCURRENT=2
GENERATION_VIDEO_MAX_CONCURRENT=4
GENERATION_VIDEO_BORROW_MAX_CONCURRENT=2
GENERATION_ENABLE_ELASTIC_LANE_BORROWING=true
GENERATION_ALLOW_VIDEO_BORROW_WHEN_IMAGE_QUEUE_EMPTY=true
GENERATION_ALLOW_VIDEO_BORROW_IMAGE_WAIT_BELOW_SECONDS=120
GENERATION_VIDEO_BORROW_RELEASE_MODE=natural_completion
GENERATION_BORROWED_VIDEO_MAX_AGE_SECONDS=0
GENERATION_BORROWING_PRIORITY_TIERS=premium,privileged,admin,free
GENERATION_VIDEO_PREPROCESSING_MAX_CONCURRENT=1
GENERATION_QUEUE_MAX_SIZE=1000
GENERATION_ESTIMATED_IMAGE_SECONDS=90
GENERATION_ESTIMATED_VIDEO_SECONDS=420
GENERATION_ESTIMATED_VIDEO_PREPROCESSING_SECONDS=90
GENERATION_FREE_IMAGE_MAX_WAIT_SECONDS=1800
GENERATION_PREMIUM_IMAGE_MAX_WAIT_SECONDS=900
GENERATION_PRIVILEGED_IMAGE_MAX_WAIT_SECONDS=900
GENERATION_FREE_VIDEO_MAX_WAIT_SECONDS=3600
GENERATION_PREMIUM_VIDEO_MAX_WAIT_SECONDS=1800
GENERATION_PRIVILEGED_VIDEO_MAX_WAIT_SECONDS=1800
GENERATION_PRIORITY_AGING_INTERVAL_SECONDS=60
GENERATION_PRIORITY_AGING_BOOST=500
GENERATION_CANCEL_QUEUED_ENABLED=true
TEMPLATES_REALTIME_EVENT_RETENTION_MINUTES=60
TEMPLATES_REALTIME_EVENT_CLEANUP_INTERVAL_MINUTES=10
TEMPLATES_REALTIME_EVENT_CLEANUP_BATCH_SIZE=1000
PETMAGIC_QA_FIXTURES_ENABLED=false
FAL_PROVIDER_CONCURRENCY_LIMIT=10
FAL_PROVIDER_RESERVED_CONCURRENCY=2
FAL_PROVIDER_BALANCE_LOW_THRESHOLD_USD=100
FAL_PROVIDER_BALANCE_CRITICAL_THRESHOLD_USD=25
FAL_PROVIDER_SPEND_DAILY_LIMIT_USD=0
FAL_WEBHOOK_URL=

# Worker-only deployment env.
# Templates__GenerationWorkerEnabled=true
# Templates__MediaCleanupWorkerEnabled=false
# Templates__TemplateOfTheDayAutoPickWorkerEnabled=false
GENERATION_WORKER_REPLICAS=4
GENERATION_WORKER_MAX_CONCURRENT_JOBS=2
GENERATION_WORKER_POLL_INTERVAL_MS=500
GENERATION_PROVIDER_MAX_RPM=60
GENERATION_MAX_ATTEMPTS=3
GENERATION_JOB_LOCK_TIMEOUT_MS=900000
GENERATION_ORPHAN_QUEUED_TIMEOUT_MS=120000
GENERATION_REFUND_RETRY_DELAY_MS=30000
Templates__MaxRefundAttempts=5
Templates__RefundRetryDelayMilliseconds=30000
Templates__Fal__StartTimeoutSeconds=120
Templates__Fal__ImageMaxPollingAttempts=180
Templates__Fal__ImagePreprocessingMaxPollingAttempts=180
Templates__Fal__VideoMaxPollingAttempts=300

# Secrets and staging-only URLs. Fill manually in secret storage; do not paste
# values into docs, PRs, issues, or Codex prompts.
ConnectionStrings__DefaultConnection=
POSTGRES_PASSWORD=replace_with_staging_postgres_password
FAL_AI_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
NEXT_PUBLIC_API_BASE_URL=https://api.staging.petmagic.app
INTERNAL_API_BASE_URL=http://backend:5000
BACKEND_PUBLIC_BASE_URL=https://api.staging.petmagic.app
BACKEND_ALLOWED_HOSTS=api.staging.petmagic.app
BACKEND_HEALTHCHECK_HOST=api.staging.petmagic.app
JWT_SIGNING_KEY=replace_with_staging_64_byte_base64_key_replace_with_staging_64_byte_base64_key
DATA_PROTECTION_CERTIFICATE_PASSWORD=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
ALERTMANAGER_WEBHOOK_URL=https://alerts.staging.petmagic.app/petmagic-alerts
GRAFANA_ADMIN_PASSWORD=replace_with_staging_grafana_password
