# Copy to .env.local-smoke and fill with local development values only.
# This mode is not staging or production rollout evidence. Do not use production secrets.

LOCAL_API_BASE_URL=http://localhost:<api-port>
LOCAL_DATABASE_URL=Host=localhost;Port=<postgres-port>;Database=<db>;Username=<user>;Password=<password>
JWT_SIGNING_KEY=replace_with_local_64_byte_base64_key
LOCAL_IMAGE_TEMPLATE_ID=
LOCAL_VIDEO_TEMPLATE_ID=
LOCAL_FAILING_TEMPLATE_ID=
LOCAL_FREE_JWT=
LOCAL_PREMIUM_JWT=

# Optional:
LOCAL_FREE_AUTH_TOKENS=
LOCAL_PREMIUM_AUTH_TOKENS=
LOCAL_PROMETHEUS_BASE_URL=
LOCAL_FAILING_TEMPLATE_MEDIA_TYPE=image
LOCAL_SMOKE_TOTAL=20
LOCAL_SUBMIT_CONCURRENCY=4
LOCAL_POLL_ATTEMPTS=60
LOCAL_POLL_DELAY_MS=1000
LOCAL_REALTIME_GROWTH_BUDGET=200
LOCAL_MIN_EXISTING_GENERATIONS=0
LOCAL_USE_QA_FIXTURES=true
LOCAL_SOURCE_IMAGE_PATH=
LOCAL_PSQL_COMMAND=docker-compose-psql
LOCAL_ARTIFACT_DIR=

# Docker Compose local-smoke placeholders. Keep these development-only values out of production.
POSTGRES_HOST_PORT=56543
BACKEND_HOST_PORT=5601
ADMIN_WEB_HOST_PORT=3600
MAILPIT_SMTP_HOST_PORT=1625
MAILPIT_WEB_HOST_PORT=8625
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
POSTGRES_PASSWORD=replace_with_local_smoke_postgres_password
DATA_PROTECTION_CERTIFICATE_PASSWORD=replace_with_local_smoke_data_protection_password
BACKEND_PUBLIC_BASE_URL=http://localhost:5601
BACKEND_ALLOWED_HOSTS=localhost;127.0.0.1;[::1];backend
BACKEND_HEALTHCHECK_HOST=localhost
TEMPLATES_STORAGE_PROVIDER=Local
TEMPLATES_AI_PROVIDER=Fake
TEMPLATES_TEMPLATE_OF_THE_DAY_AUTO_PICK_WORKER_ENABLED=false
PETMAGIC_LOCAL_SMOKE_FAST_FAKE_COMPLETION=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:5601
INTERNAL_API_BASE_URL=http://backend:5000
ADMIN_WEB_ALLOW_LOCALHOST_API_BASE_URL_IN_PRODUCTION=true
ALERTMANAGER_WEBHOOK_URL=http://localhost:9/local-smoke-alertmanager-placeholder
GRAFANA_ADMIN_PASSWORD=replace_with_local_smoke_grafana_password
