# Copy to .env.local-smoke and fill with local development values only.
# This mode is not staging or production rollout evidence. Do not use production secrets.

LOCAL_API_BASE_URL=http://localhost:<api-port>
LOCAL_DATABASE_URL=Host=localhost;Port=<postgres-port>;Database=<db>;Username=<user>;Password=<password>
LOCAL_IMAGE_TEMPLATE_ID=
LOCAL_VIDEO_TEMPLATE_ID=
LOCAL_FAILING_TEMPLATE_ID=
LOCAL_FREE_JWT=
LOCAL_PREMIUM_JWT=

# Optional:
LOCAL_FREE_AUTH_TOKENS=
LOCAL_PREMIUM_AUTH_TOKENS=
LOCAL_PROMETHEUS_BASE_URL=
LOCAL_FAILING_TEMPLATE_MEDIA_TYPE=image
LOCAL_SMOKE_TOTAL=20
LOCAL_SUBMIT_CONCURRENCY=4
LOCAL_POLL_ATTEMPTS=60
LOCAL_POLL_DELAY_MS=1000
LOCAL_REALTIME_GROWTH_BUDGET=200
LOCAL_MIN_EXISTING_GENERATIONS=0
LOCAL_SOURCE_IMAGE_PATH=
LOCAL_PSQL_COMMAND=docker-compose-psql
LOCAL_ARTIFACT_DIR=
