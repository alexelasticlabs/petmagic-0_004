<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Suppress accepted known vulnerabilities: OpenTelemetry (stable), Microsoft.Build (transitive, dev-only) -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Keep trimming off by default to avoid reflection-related runtime regressions. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentFiles; analyzers; buildTransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.CorrelationId" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Economy\PetMagic.Modules.Economy.Api\PetMagic.Modules.Economy.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Economy\PetMagic.Modules.Economy.Infrastructure\PetMagic.Modules.Economy.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\PetMagic.Modules.Identity.Api\PetMagic.Modules.Identity.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\PetMagic.Modules.Identity.Infrastructure\PetMagic.Modules.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\SupportChat\PetMagic.Modules.SupportChat.Api\PetMagic.Modules.SupportChat.Api.csproj" />
    <ProjectReference Include="..\..\Modules\SupportChat\PetMagic.Modules.SupportChat.Infrastructure\PetMagic.Modules.SupportChat.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Templates\PetMagic.Modules.Templates.Api\PetMagic.Modules.Templates.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Templates\PetMagic.Modules.Templates.Infrastructure\PetMagic.Modules.Templates.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Gamification\PetMagic.Modules.Gamification.Api\PetMagic.Modules.Gamification.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Gamification\PetMagic.Modules.Gamification.Infrastructure\PetMagic.Modules.Gamification.Infrastructure.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\PetMagic.BuildingBlocks\PetMagic.BuildingBlocks.csproj" />
  </ItemGroup>

</Project>
